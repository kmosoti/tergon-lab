{
  "schema": 1,
  "task": "MNIST classifier learning feasibility; no throughput, energy or total memory savings claim",
  "device": "cuda:0",
  "seeds": [
    17,
    29,
    43
  ],
  "modes": [
    "ternary",
    "float"
  ],
  "epochs": 10,
  "batch_size": 128,
  "max_run_seconds": 1800,
  "architecture": [
    784,
    128,
    10
  ],
  "activation": "ReLU",
  "pixels": "f32(byte)/255",
  "train_range": [
    0,
    55000
  ],
  "validation_range": [
    55000,
    60000
  ],
  "test_range": [
    0,
    10000
  ],
  "initializer": "host He uniform [-sqrt(6/fan_in),sqrt(6/fan_in)], zero bias",
  "rng": "SplitMix64; Fisher-Yates with unbiased bounded rejection; state serialized",
  "optimizer": {
    "name": "Burn 0.22.1 AdamW",
    "learning_rate": 0.001,
    "beta1": 0.9,
    "beta2": 0.999,
    "epsilon": 1e-08,
    "matrix_weight_decay": 0.01,
    "bias_weight_decay": 0.0,
    "amsgrad": false,
    "cautious_weight_decay": false,
    "clipping": false,
    "scheduler": false
  },
  "loss": "mean softmax cross entropy",
  "augmentation": false,
  "dropout": false,
  "normalization": false,
  "activation_quantization": false,
  "acceptance": {
    "ternary_test_accuracy": 0.9,
    "float_test_accuracy": 0.95
  },
  "resume_check": {
    "at_step": 200,
    "updates": 50,
    "cpu": "bitwise",
    "gpu_atol": 1e-05,
    "gpu_rtol": 0.0001
  },
